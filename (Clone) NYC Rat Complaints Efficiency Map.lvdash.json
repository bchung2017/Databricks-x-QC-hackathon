{
  "datasets": [
    {
      "name": "zip_efficiency",
      "displayName": "ZIP Code Resolution Efficiency",
      "queryLines": [
        "WITH zip_totals AS (\n",
        "  SELECT\n",
        "    incident_zip,\n",
        "    borough,\n",
        "    COUNT(*) AS total_received,\n",
        "    SUM(CASE WHEN status != 'Closed' THEN 1 ELSE 0 END) AS unresolved_count\n",
        "  FROM\n",
        "    nyc_data.default.rat_sightings\n",
        "  WHERE\n",
        "    borough != 'Unspecified'\n",
        "        AND latitude IS NOT NULL\n",
        "    AND longitude IS NOT NULL\n",
        "    AND latitude BETWEEN 40.4 AND 41.0\n",
        "    AND longitude BETWEEN -74.3 AND -73.7\n",
        "  GROUP BY\n",
        "    incident_zip, borough\n",
        ")\n",
        "SELECT\n",
        "  rs.incident_zip,\n",
        "  rs.borough,\n",
        "  ROUND(AVG(rs.latitude), 5) AS lat,\n",
        "  ROUND(AVG(rs.longitude), 5) AS lng,\n",
        "  COUNT(*) AS total_closed,\n",
        "  MAX(zt.total_received) AS total_received,\n",
        "  MAX(zt.unresolved_count) AS unresolved_count,\n",
        "  ROUND(AVG(DATEDIFF(rs.closed_date, rs.created_date)), 1) AS avg_days,\n",
        "  percentile_approx(DATEDIFF(rs.closed_date, rs.created_date), 0.5) AS median_days,\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN DATEDIFF(rs.closed_date, rs.created_date) = 0 THEN 1\n",
        "        ELSE 0\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) AS same_day_pct,\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN DATEDIFF(rs.closed_date, rs.created_date) > 14 THEN 1\n",
        "        ELSE 0\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) AS slow_resolution_pct,\n",
        "  ROUND(\n",
        "    COUNT(*) * 1.0 / NULLIF(AVG(DATEDIFF(rs.closed_date, rs.created_date)), 0),\n",
        "    1\n",
        "  ) AS efficiency_score,\n",
        "  CASE\n",
        "    WHEN\n",
        "      ROUND(COUNT(*) * 1.0 / NULLIF(AVG(DATEDIFF(rs.closed_date, rs.created_date)), 0), 1) >= 200\n",
        "    THEN\n",
        "      'Excellent (200+)'\n",
        "    WHEN\n",
        "      ROUND(COUNT(*) * 1.0 / NULLIF(AVG(DATEDIFF(rs.closed_date, rs.created_date)), 0), 1) >= 100\n",
        "    THEN\n",
        "      'Good (100-199)'\n",
        "    WHEN\n",
        "      ROUND(COUNT(*) * 1.0 / NULLIF(AVG(DATEDIFF(rs.closed_date, rs.created_date)), 0), 1) >= 50\n",
        "    THEN\n",
        "      'Fair (50-99)'\n",
        "    ELSE 'Needs Improvement (<50)'\n",
        "  END AS efficiency_tier\n",
        "FROM\n",
        "  nyc_data.default.rat_sightings rs\n",
        "    JOIN zip_totals zt\n",
        "      ON rs.incident_zip = zt.incident_zip\n",
        "      AND rs.borough = zt.borough\n",
        "WHERE\n",
        "  rs.status = 'Closed'\n",
        "  AND rs.borough != 'Unspecified'\n",
        "  AND rs.latitude IS NOT NULL\n",
        "  AND rs.longitude IS NOT NULL\n",
        "  AND rs.latitude BETWEEN 40.4 AND 41.0\n",
        "  AND rs.longitude BETWEEN -74.3 AND -73.7\n",
        "GROUP BY\n",
        "  rs.incident_zip,\n",
        "  rs.borough\n",
        "HAVING\n",
        "  COUNT(*) >= 1\n",
        "ORDER BY\n",
        "  efficiency_score DESC"
      ],
      "catalog": "nyc_data",
      "schema": "default"
    }
  ],
