{
  "datasets": [
    {
      "name": "4e2b54cc",
      "displayName": "Rodent Activity and Restaurant Inspection Summary NYC",
      "queryLines": [
        "SELECT\r\n",
        "  zip_code,\r\n",
        "  borough,\r\n",
        "  distinct_restaurant_count,\r\n",
        "  inspection_event_count,\r\n",
        "  avg_inspection_score,\r\n",
        "  rodent_evidence_restaurant_pct,\r\n",
        "  COALESCE(rodent_complaint_count, 0)  AS rodent_complaint_count,\r\n",
        "  COALESCE(rat_sighting_count, 0)      AS rat_sighting_count,\r\n",
        "  COALESCE(mouse_sighting_count, 0)    AS mouse_sighting_count,\r\n",
        "  COALESCE(signs_of_rodents_count, 0)  AS signs_of_rodents_count,\r\n",
        "  COALESCE(complaints_last_90d, 0)     AS complaints_last_90d,\r\n",
        "  avg_days_to_close,\r\n",
        "  centroid_lat,\r\n",
        "  centroid_lon,\r\n",
        "  has_rodent_data\r\n",
        "FROM nyc_data.default.rodent_restaurant_merge_unix_zip;"
      ]
    },
    {
      "name": "f00bd052",
      "displayName": "service_gap_index_zip_seasonal",
      "config": {
        "source": "nyc_data.default.service_gap_index_zip_seasonal",
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "total_reports",
            "expr": "SUM(`demand_raw`)",
            "displayName": "Total Reports"
          }
        ],
        "filter": "centroid_lat IS NOT NULL",
        "version": "1.1",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ]
      }
    },
    {
      "name": "borough_monthly",
      "displayName": "Borough Monthly Trends",
      "config": {
        "source": "WITH d AS (\n  SELECT INITCAP(borough) AS borough, DATE_TRUNC('month', created_date) AS month,\n         COUNT(*) AS complaints\n  FROM nyc_data.default.rat_sightings\n  WHERE descriptor IN ('Rat Sighting','Mouse Sighting','Signs of Rodents')\n    AND borough <> 'Unspecified'\n  GROUP BY 1, 2\n),\ne AS (\n  SELECT camis, zip_normalized, inspection_date, has_direct_rodent_evidence,\n         LEAD(inspection_date) OVER (PARTITION BY camis ORDER BY inspection_date) AS next_date\n  FROM nyc_data.default.restaurant_inspection_events_v2\n  WHERE zip_normalized IS NOT NULL\n),\ni AS (\n  SELECT m.most_common_borough AS borough, DATE_TRUNC('month', e.inspection_date) AS month,\n         COUNT(*) AS inspections,\n         COUNT_IF(e.has_direct_rodent_evidence) AS rodent_hits,\n         CAST(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY\n           CASE WHEN e.has_direct_rodent_evidence THEN DATEDIFF(e.next_date, e.inspection_date) END) AS INT)\n         AS median_followup_days\n  FROM e JOIN nyc_data.default.restaurant_zip_metrics_v4 m ON e.zip_normalized = m.zip_code\n  GROUP BY 1, 2\n),\nfinal AS (\n  SELECT COALESCE(d.borough, i.borough) AS borough,\n         COALESCE(d.month, i.month)     AS month,\n         d.complaints, i.inspections, i.rodent_hits, i.median_followup_days,\n         i.inspections / NULLIF(d.complaints, 0) AS inspections_per_complaint\n  FROM d FULL OUTER JOIN i ON d.borough = i.borough AND d.month = i.month\n  WHERE COALESCE(d.borough, i.borough) IS NOT NULL\n    AND COALESCE(d.borough, i.borough) <> 'Missing'\n)\nSELECT borough, month, '311 Complaints' AS metric, CAST(complaints AS DOUBLE) AS value FROM final WHERE complaints IS NOT NULL\nUNION ALL\nSELECT borough, month, 'Median Follow-up Days' AS metric, CAST(median_followup_days AS DOUBLE) AS value FROM final WHERE median_followup_days IS NOT NULL\nUNION ALL\nSELECT borough, month, 'Inspections per Complaint' AS metric, inspections_per_complaint AS value FROM final WHERE inspections_per_complaint IS NOT NULL\n",
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)"
          }
        ],
        "filter": "month >= DATE_TRUNC('month', CURRENT_DATE - INTERVAL '12 MONTHS') AND month < DATE_TRUNC('month', CURRENT_DATE)",
        "version": "1.1",
        "dimensions": [
          {
            "name": "borough",
            "expr": "borough"
          },
          {
            "name": "month",
            "expr": "month"
          },
          {
            "name": "metric",
            "expr": "metric"
          },
          {
            "name": "value",
            "expr": "value"
          }
        ]
      }
    }
  ],
